# The "Request" modal emails each request through Resend. Set these in Vercel → Settings → Environment
# Variables, and in .env.local to send real emails from the dev server (without them, dev prints requests instead).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
REQUEST_TO=you@example.com
# Optional: a sender on a domain verified in Resend. Without it, Resend's test sender only delivers to your own Resend address.
REQUEST_FROM=Compo <requests@example.com>
